# ===== 复制为 .env 并填写（.env 已被 .gitignore 忽略，不会上传） =====
# 本部署所需的所有可配置变量。必填项不填会导致注册/同步失败。

# ---------- 代理（二选一，必须） ----------
# 方式 A：mihomo 聚合 Clash 订阅（推荐，自动轮换节点）
# 填入你的 Clash 订阅链接（含 clash=3&extend=1 等参数）
MOHOMO_SUB_URL=

# 方式 B：anytls 单节点（备用）
# ANYTLS_SERVER=host:port
# ANYTLS_PASSWORD=password
# ANYTLS_SNI=host

# ---------- chatgpt2api 管理 ----------
# c2a 管理 key（也是 c2a API 的 Bearer），默认即可，生产建议改复杂
CHATGPT2API_AUTH_KEY=test_key_123

# ---------- glue 胶水层 ----------
GLUE_TOKEN=glue-shared-secret
# 主动同步轮询间隔（秒）
SYNC_INTERVAL=10
# 自动补货开关
AUTO_REGISTER_ENABLED=true
# 可用账号低于此数触发补注册
MIN_AVAILABLE=5
# 每次补注册几个
REGISTER_BATCH=2
# 仅最近有流量时才补（省代理流量）
ONLY_ON_TRAFFIC=true
# 流量窗口（分钟）
TRAFFIC_WINDOW_MIN=15
# 自动补货检查间隔（秒）
CHECK_INTERVAL=60
# 注册模式：access_token（默认，避手机验证）/ refresh_token
AAR_REGISTER_MODE=
